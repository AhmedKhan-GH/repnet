 author = {Raffaelli, Ricciarda and Antonia Prioli, Maria and Parissone, Francesca and Prati, Daniele and Carli, Michela and Bergamini, Corinna and Cacici, Giuseppe and Balestreri, Debora and Vassanelli, Corrado and Franchi, Massimo},
