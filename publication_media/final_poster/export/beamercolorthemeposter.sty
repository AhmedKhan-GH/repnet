% Generic color theme for the Gemini beamer poster theme.
% Adapted from the UC Davis color theme by Rylan Schaeffer's
% Stanford-LaTeX-Poster-Template.
%
% Customize the six colors below to match your institution's brand.
%
% Default palette:
%   Primary    #1B3A5C  (dark navy)
%   Accent     #E8A838  (warm amber)

\ProvidesPackage{beamercolorthemeposter}[2026/05/14 Generic poster color theme]

% ---- Edit these to match your brand ----
\definecolor{primaryColor}{HTML}{1B3A5C}
\definecolor{accentColor}{HTML}{E8A838}
\definecolor{primaryDark}{HTML}{0F2440}
\definecolor{accentDark}{HTML}{B07E20}
\definecolor{coolgray}{RGB}{77,79,83}
\definecolor{boxgray}{RGB}{238,235,233}
\definecolor{footergold}{HTML}{F5DFA0}

\mode<presentation>

% Palette
\setbeamercolor*{palette primary}{use=structure,fg=white,bg=primaryColor}
\setbeamercolor*{palette secondary}{use=structure,fg=white,bg=coolgray}
\setbeamercolor*{palette tertiary}{use=structure,fg=white,bg=primaryDark}
\setbeamercolor*{palette quaternary}{fg=primaryColor,bg=accentColor}

% Headline / footer
\setbeamercolor{headline}{bg=primaryColor,fg=white}
\setbeamercolor{headline rule}{bg=accentColor}
\setbeamercolor*{footer}{use=structure,bg=primaryColor,fg=white}

% Headline text
\setbeamercolor{headline title}{fg=white}
\setbeamercolor{headline author}{fg=accentColor}
\setbeamercolor{headline institute}{fg=white}

% Standard blocks
\setbeamercolor{block title}{fg=primaryColor,bg=white}
\setbeamercolor{block separator}{bg=accentColor}
\setbeamercolor{block body}{fg=black,bg=white}

% Alert blocks
\setbeamercolor{block alerted title}{fg=primaryColor,bg=white}
\setbeamercolor{block alerted separator}{bg=accentColor}
\setbeamercolor{block alerted body}{fg=black,bg=boxgray}

% Sidebars
\setbeamercolor*{sidebar}{use=structure,bg=accentColor}
\setbeamercolor*{palette sidebar primary}{use=structure,fg=primaryColor}
\setbeamercolor*{palette sidebar secondary}{fg=primaryColor}
\setbeamercolor*{palette sidebar tertiary}{use=structure,fg=primaryDark}
\setbeamercolor*{palette sidebar quaternary}{fg=primaryColor}

\setbeamercolor*{titlelike}{parent=palette primary}
\setbeamercolor*{foot line}{parent=palette secondary}

\setbeamercolor*{separation line}{}
\setbeamercolor*{fine separation line}{}

% Lists
\setbeamercolor{itemize item}{fg=primaryColor}
\setbeamercolor{itemize subitem}{fg=primaryColor}
\setbeamercolor{itemize subsubitem}{fg=primaryColor}
\setbeamercolor{enumerate item}{fg=primaryColor}
\setbeamercolor{enumerate subitem}{fg=primaryColor}
\setbeamercolor{enumerate subsubitem}{fg=primaryColor}
\setbeamercolor{description item}{fg=primaryColor}

% Headings
\setbeamercolor{heading}{fg=primaryColor}

% Bibliography
\setbeamertemplate{bibliography item}[text]
\setbeamertemplate{frametitle continuation}[from second]
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor*{bibliography entry location}{fg=black}
\setbeamercolor*{bibliography entry note}{fg=black}

\mode
<all>
